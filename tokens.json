{
  "$description": "DOPK Vitals design tokens (W3C Design Tokens format). Colour follows medical alarm priorities (IEC 60601-1-8).",
  "color": {
    "steel": {
      "050": { "$type": "color", "$value": "#F6F7F6", "$description": "Surface" },
      "100": { "$type": "color", "$value": "#ECEFEE", "$description": "Page background" },
      "200": { "$type": "color", "$value": "#DDE2E0", "$description": "Soft rules, hover" },
      "300": { "$type": "color", "$value": "#C4CBC9", "$description": "Rules" },
      "500": { "$type": "color", "$value": "#7C8689", "$description": "Faint text" },
      "700": { "$type": "color", "$value": "#4D575B", "$description": "Muted text" }
    },
    "graphite": { "$type": "color", "$value": "#1F2629", "$description": "Ink, primary buttons, top customer" },
    "alarm": {
      "high":      { "$type": "color", "$value": "#CF2E3E", "$description": "Act now: overdue, errors" },
      "high-tint": { "$type": "color", "$value": "#F8E1E3" },
      "med":       { "$type": "color", "$value": "#E9A800", "$description": "Watch: undated, concentration, pricing" },
      "med-tint":  { "$type": "color", "$value": "#FBF0CC" },
      "low":       { "$type": "color", "$value": "#11879A", "$description": "Information: scheduled flow" },
      "low-tint":  { "$type": "color", "$value": "#D6EEF1" }
    },
    "clear":      { "$type": "color", "$value": "#2E7D55", "$description": "Resolved: shipped, on time" },
    "clear-tint": { "$type": "color", "$value": "#DCEEE3" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "Atkinson Hyperlegible", "Segoe UI", "system-ui", "sans-serif"] },
    "size": {
      "xs":  { "$type": "dimension", "$value": "12px" },
      "sm":  { "$type": "dimension", "$value": "14px" },
      "md":  { "$type": "dimension", "$value": "16px" },
      "lg":  { "$type": "dimension", "$value": "21px" },
      "xl":  { "$type": "dimension", "$value": "28px" },
      "2xl": { "$type": "dimension", "$value": "38px" },
      "3xl": { "$type": "dimension", "$value": "50px" }
    },
    "weight": { "light": { "$type": "fontWeight", "$value": 300 }, "regular": { "$type": "fontWeight", "$value": 400 }, "bold": { "$type": "fontWeight", "$value": 700 }, "heavy": { "$type": "fontWeight", "$value": 800 } }
  },
  "space": { "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" }, "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" }, "5": { "$type": "dimension", "$value": "24px" }, "6": { "$type": "dimension", "$value": "32px" }, "7": { "$type": "dimension", "$value": "48px" }, "8": { "$type": "dimension", "$value": "64px" } },
  "radius": { "panel": { "$type": "dimension", "$value": "0px" }, "control": { "$type": "dimension", "$value": "6px" }, "pill": { "$type": "dimension", "$value": "999px" } },
  "rules": {
    "overdue-pct":  { "$description": "% of open value past due", "high": 5, "med": 2 },
    "undated-pct":  { "$description": "% of open value without delivery date", "high": 15, "med": 5 },
    "on-time-pct":  { "$description": "% of today's shipped lines on time; below threshold raises alarm", "high": 90, "med": 97 },
    "hhi":          { "$description": "Customer concentration index", "high": 2500, "med": 1500 },
    "price-outlier":{ "$description": "Unit price vs article median across 3+ customers", "low": 0.6, "high": 1.6 }
  }
}
